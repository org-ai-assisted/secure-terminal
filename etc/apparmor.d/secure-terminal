# AppArmor profile for secure-terminal.
#
# Defence-in-depth for the terminal PROCESS itself (a PyQt6 GUI that parses
# untrusted program output): it confines what the GUI can read and write, while
# the shells and programs it launches -- the user's own commands -- run
# unconfined, because confining them would defeat a terminal's whole purpose.
#
# AI-Assisted. Validate with aa-logprof on the target before enforcing; ship in
# complain mode first if unsure (aa-complain secure-terminal).

abi <abi/4.0>,

include <tunables/global>

profile secure-terminal /usr/bin/secure-terminal {
  include <abstractions/base>
  include <abstractions/consoles>
  include <abstractions/python>
  include <abstractions/qt6>
  include <abstractions/qt6-compose-cache-write>
  include <abstractions/qt6-settings-write>
  include <abstractions/X>
  include <abstractions/wayland>
  include <abstractions/mesa>
  # audio: only for the opt-in audible bell with a custom sound file (QSoundEffect
  # -> the audio server). The default bell is the X11 beep, which needs no audio.
  include <abstractions/audio>
  include <abstractions/fonts>
  include <abstractions/freedesktop.org>
  include <abstractions/dbus-session-strict>
  include <abstractions/nameservice-strict>

  # the application code (the python3 interpreter is this profile's own exec, so
  # it needs no rule; the shell children below are what transition)
  /usr/bin/ r,
  /usr/bin/secure-terminal r,
  /usr/lib/python3/dist-packages/secure_terminal/{,**} r,
  /usr/share/secure-terminal/{,**} r,
  /usr/share/applications/secure-terminal.desktop r,
  /usr/share/icons/{,**} r,
  # bell sound files (audible channel, custom sound), read-only, from the allowed
  # directories only -- matches BELL_SOUND_DIRS / sound_file_allowed(). The third,
  # /usr/share/secure-terminal/sounds, is already covered above.
  /usr/share/sounds/{,**} r,
  owner @{HOME}/.local/share/sounds/{,**} r,

  # settings drop-ins (system + user) and per-tab session state
  /usr/lib/secure-terminal.d/{,**} r,
  /etc/secure-terminal.d/{,**} r,
  /usr/local/etc/secure-terminal.d/{,**} r,
  owner @{HOME}/.config/secure-terminal.d/ rw,
  owner @{HOME}/.config/secure-terminal.d/{,**} rwkl,
  owner @{HOME}/.local/state/secure-terminal/ rw,
  owner @{HOME}/.local/state/secure-terminal/{,**} rwkl,

  # single-instance IPC: an owner-only (0700) Unix socket under the runtime dir,
  # so a second launch reuses the running instance.
  owner /run/user/[0-9]*/secure-terminal/ rw,
  owner /run/user/[0-9]*/secure-terminal/*.sock rwkl,
  # QLocalServer(UserAccessOption) does NOT bind the 0700 socket in place: it
  # creates a private 0700 temp SUBDIR, binds the socket inside it, renames the
  # socket to <group>.sock, then removes the subdir. Without a rule for that
  # transient subdir + its socket, mkdir is denied -> listen() fails EACCES ->
  # no single-instance primary, so every --reuse opens a NEW window. The subtree
  # is already owner-only 0700, so allowing one level below stays tight.
  owner /run/user/[0-9]*/secure-terminal/*/ rw,
  owner /run/user/[0-9]*/secure-terminal/*/* rwkl,
  # clipboard-watch singleton gate: an owner-only flock lock file (needs 'k').
  owner /run/user/[0-9]*/secure-terminal/*.lock rwk,

  # --test-canary positive control (for security-test harnesses): a fixed,
  # owner-only marker under the predefined runtime subtree. Confined to exactly
  # this folder -- the canary action can write nowhere else.
  owner /run/user/[0-9]*/secure-terminal/canary/ rw,
  owner /run/user/[0-9]*/secure-terminal/canary/* rwk,
  unix (create, bind, listen, shutdown, getattr, setattr) type=stream,
  unix (accept, connect, send, receive) type=stream
        peer=(label=@{profile_name}),

  # Per-tab resource isolation (cgroup v2): the app creates a limited child cgroup
  # per tab under its OWN delegated cgroup and places each tab's shell into it, so a
  # fork bomb or memory runaway is bounded to that one tab. Scoped TIGHTLY to the
  # app's OWN systemd app scope (app-...secure-terminal....scope, the * spanning
  # systemd's `\x2d` escaping and any launcher prefix) -- NOT the whole user slice, so
  # a compromised GUI (it parses untrusted program output) cannot move or throttle
  # OTHER user processes via their cgroups; only its own tabs. A shell-launched
  # instance lands in a shared session scope where base_setup() cannot relocate (the
  # cgroup-v2 no-internal-process rule), so it fails open there and needs no grant.
  # The subtree read picks up controllers + limits; the dir rule permits mkdir/rmdir
  # of the main + tab-N leaves; the named files are the cgroup knobs written.
  /sys/fs/cgroup/user.slice/user-[0-9]*.slice/**/app-*secure*terminal*.scope/** r,
  /sys/fs/cgroup/user.slice/user-[0-9]*.slice/**/app-*secure*terminal*.scope/**/ rw,
  /sys/fs/cgroup/user.slice/user-[0-9]*.slice/**/app-*secure*terminal*.scope/cgroup.subtree_control rw,
  /sys/fs/cgroup/user.slice/user-[0-9]*.slice/**/app-*secure*terminal*.scope/**/cgroup.procs rw,
  /sys/fs/cgroup/user.slice/user-[0-9]*.slice/**/app-*secure*terminal*.scope/**/pids.max rw,
  /sys/fs/cgroup/user.slice/user-[0-9]*.slice/**/app-*secure*terminal*.scope/**/memory.max rw,
  /sys/fs/cgroup/user.slice/user-[0-9]*.slice/**/app-*secure*terminal*.scope/**/memory.swap.max rw,
  /sys/fs/cgroup/user.slice/user-[0-9]*.slice/**/app-*secure*terminal*.scope/**/memory.oom.group rw,

  # the login shell and $SHELL lookup
  /etc/shells r,
  /etc/passwd r,
  /etc/zsh/{,**} r,

  # pseudo-terminals for the child shells
  /dev/ptmx rw,
  /dev/pts/ r,
  owner /dev/pts/[0-9]* rw,

  # secure-terminal is a terminal: it launches the user's login shell and, via
  # "New Tab Running...", other programs. Those are the user's own commands and
  # run UNCONFINED -- confining them here would break the terminal's purpose.
  /{,usr/}bin/*     Ux,
  /{,usr/}sbin/*    Ux,
  /usr/local/bin/*  Ux,
  /usr/local/sbin/* Ux,

  # site additions (an extra shell) go here without editing this file
  include if exists <local/secure-terminal>
}
