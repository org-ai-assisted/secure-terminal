## AI-Assisted

## unicode-tag: read bytes from stdin (or file arguments), write them back with
## every deceptive Unicode code point replaced by an inline [U+XXXX NAME] token
## and all honest text untouched. Byte-faithful; for machine/LLM consumption.
## See secure_terminal/unicode_tag.py for the policy.

import os
import sys

## Run straight from a source checkout, not only when installed (see the GUI
## launcher for the rationale).
_dev = os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
    'lib', 'python3', 'dist-packages')
if os.path.isdir(os.path.join(_dev, 'secure_terminal')):
    sys.path.insert(0, _dev)

## Fail loud on a missing runtime dependency before the app import: the classifier
## needs \X (regex) and the mixed-script data (confusable_homoglyphs).
from secure_terminal.preflight import require
require(('regex', 'python3-regex'),
        ('confusable_homoglyphs', 'python3-confusable-homoglyphs'))

from secure_terminal.unicode_tag import main

if __name__ == '__main__':
    sys.exit(main())
