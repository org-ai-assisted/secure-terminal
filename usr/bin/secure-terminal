#!/usr/bin/python3 -Bsu

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

import os
import sys

## Run straight from a source checkout, not only when installed. When installed,
## the module is under /usr/lib/python3/dist-packages (already on sys.path); from
## a checkout it is under <repo>/usr/lib/python3/dist-packages, so add that.
_dev = os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
    'lib', 'python3', 'dist-packages')
if os.path.isdir(os.path.join(_dev, 'secure_terminal')):
    sys.path.insert(0, _dev)

## Fail loud on a missing runtime dependency (clear stderr message + non-zero
## exit) before the heavy import below would traceback.
from secure_terminal.preflight import require
require(
    ('PyQt6.QtWidgets', 'python3-pyqt6'),
    ('PyQt6.QtMultimedia', 'python3-pyqt6.qtmultimedia'),
    ('pyte', 'python3-pyte'),
    # Not optional, despite sanitize importing it defensively: without it
    # _ASCII_CONFUSABLES is empty and every homoglyph silently drops from the
    # `confusable` risk class to generic `nonascii` -- a security classification
    # degrading with no signal, indistinguishable from "this input has no
    # look-alikes". A partial install must fail here instead.
    ('confusable_homoglyphs', 'python3-confusable-homoglyphs'),
    # \X (UAX #29 grapheme clusters): the stdlib re has no equivalent and the
    # property is not derivable from the general categories, so the flood cap
    # depends on it. Absent module must not mean absent cap.
    ('regex', 'python3-regex'),
    # East-Asian / emoji display width: terminal.py sizes the pyte grid and the
    # combining-mark cap by wcwidth. Absent module tracebacks on the terminal
    # import instead of reporting the missing package here.
    ('wcwidth', 'python3-wcwidth'),
)

from secure_terminal.main import main
from secure_terminal.resource_isolation import base_setup

if __name__ == '__main__':
    ## Prepare per-tab resource isolation ONCE, here in the launcher. base_setup()
    ## relocates THIS process's cgroup (the cgroup v2 "no internal processes" rule) so
    ## each tab can get its own limited child cgroup -- a one-time side effect that
    ## belongs to the real app process, not the importable main() the in-process tests
    ## drive. None when the host does not delegate memory+pids cgroup v2 controllers;
    ## tabs then just share the session's own limits. Note it on stderr, once.
    _cg_base = base_setup()
    if _cg_base is None:
        sys.stderr.write(
            'secure-terminal: per-tab resource isolation unavailable (no cgroup v2 '
            'delegation); tabs share the session limits\n')
    sys.exit(main(cg_base=_cg_base))
