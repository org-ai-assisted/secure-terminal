#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## st-wl-copy: drop-in for wl-copy that sanitizes on WRITE. Filters stdin through
## sclip, then hands the safe text to `wl-copy` with every argument forwarded
## verbatim (native options such as --primary / --trim-newline pass through). Set
## SCLIP_MODE=unicode to keep printable non-ASCII (default: ASCII-only, strictest).

## style-ok: no-has -- a standalone tool that must run on plain Debian without the
## Kicksecure helper-scripts stack, so it uses portable `command -v`, not `has`.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

dir="$(dirname -- "$(readlink -f -- "$0")")"
sclip="${dir}/sclip"

if ! command -v wl-copy >/dev/null 2>&1 ; then
   printf '%s\n' "st-wl-copy: wl-copy not found -- install wl-clipboard" >&2
   exit 127
fi

## wl-copy copies a TEXT OPERAND directly and then IGNORES stdin, so a text
## operand would bypass sclip entirely (and, with a pipe, sclip would hang on
## EOF while the raw operand is copied). This wrapper sanitizes STDIN only, so
## fail CLOSED on any text operand. Skip the values of wl-copy's value-taking
## options (-t/--type, -s/--seat) so they are not mistaken for text -- a bounded
## scan of the known value options, not a general parser.
skip_next="false"
for arg in "$@"; do
   if [ "${skip_next}" = "true" ]; then
      skip_next="false"
      continue
   fi
   case "${arg}" in
      -t|--type|-s|--seat)
         skip_next="true"
         ;;
      -*)
         ;;
      *)
         printf '%s\n' "st-wl-copy: a text operand is not sanitized -- pipe the text instead: printf %s ... | st-wl-copy" >&2
         exit 2
         ;;
   esac
done

mode=()
if [ "${SCLIP_MODE:-}" = "unicode" ]; then
   mode=(--unicode)
fi

"${sclip}" "${mode[@]}" | wl-copy "$@"
