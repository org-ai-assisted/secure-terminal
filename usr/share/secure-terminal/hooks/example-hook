#!/usr/bin/python3 -Bsu

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

"""
Example secure-terminal command hook.

secure-terminal ships no policy and no AI; this is a sample handler you point it
at. Enable it with a settings drop-in, e.g. ~/.config/secure-terminal.d/50_user.conf:

    command_hook=/usr/share/secure-terminal/hooks/example-hook
    command_hook_on_error=allow
    command_hook_transcript=none

The protocol (see secure_terminal.hook):
  - stdin  is a JSON request:  {"version":1,"command":..,"cwd":..,"tab":..,
                                "transcript":..?}
  - stdout is a JSON verdict:  {"verdict":"allow|block|ask|need_transcript",
                                "message":..?,"suggestion":..?}

This example uses only local rules (no network, fast). To judge with an AI
instead, replace decide() with a call that pipes the command to your model, e.g.
`claude --print`, and parse its answer -- keeping that logic HERE, out of the
terminal. Return need_transcript on the first pass to have secure-terminal call
you again with the scrollback attached (the cheap-then-escalate pattern), so the
long/expensive/injection-prone transcript is only sent when you actually need it.
"""

import os
import sys
import json
import re

# hooklib (sibling file) loads the rules from the drop-in tiers, so the allow /
# block / ask policy is documented, editable configuration -- not baked-in code.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import hooklib          # noqa: E402  pylint: disable=wrong-import-position

# The DEFAULT rules (verdict, regex, message, suggestion). An admin (or a user,
# if allowed) documents/edits them in example-hook-rules.conf. Piping a
# downloaded script into a privileged shell is the classic supply-chain footgun.
_DEFAULT_RULES = [
    ('block', r'\b(curl|wget|fetch)\b.*\|\s*sudo\s+(ba)?sh\b',
     'Refusing to pipe a downloaded script into a root shell.', ''),
    ('ask', r'\b(curl|wget|fetch)\b.*\|\s*(ba)?sh\b',
     'This pipes a downloaded script straight into a shell. Read it first.', ''),
    # Untrusted file -> shell: the same footgun as curl|sh but for a file you
    # already have (viewing "install docs" then piping them into a shell). A
    # homoglyph/bidi/hidden-byte doc could carry commands you never read.
    ('block', r'\b(cat|tac|zcat|xzcat|bzcat|head|tail|xxd|base64|dd)\b.*\|\s*sudo\s+(ba)?sh\b',
     'Refusing to pipe a file straight into a root shell -- its contents would run as root.', ''),
    ('ask', r'\b(cat|tac|zcat|xzcat|bzcat|head|tail|xxd|base64|dd)\b.*\|\s*(ba)?sh\b',
     'This pipes a file straight into a shell -- its contents run as commands. Read it first.', ''),
    ('ask', r'\b(ba)?sh\b\s+<\(',
     'This runs the output of a command as a script (process substitution). Read it first.', ''),
    ('ask', r'\bgit\s+push\b.*(--force|(\s|=)-f\b)',
     'A force-push can overwrite history on the remote.', ''),
    # Match sudo at line start OR immediately after a `;`/`&`/`|` separator, so a chained
    # `ls; sudo rm -rf /` is caught; a start-anchor alone (`^\s*sudo`) let it slip past.
    # A separator/anchor prefix avoids matching sudo inside a quoted arg (`echo "use sudo"`).
    ('ask', r'(?:^|[;&|])\s*sudo\b', 'This runs with root privileges.', ''),
]


def _load_rules():
    source = hooklib.read_rules('example-hook-rules.conf')
    if source is None:
        source = _DEFAULT_RULES
    compiled = []
    for verdict, pattern, message, suggestion in source:
        try:
            compiled.append((verdict, re.compile(pattern), message, suggestion))
        except re.error:
            continue                 # skip a malformed custom pattern
    if not compiled:                 # a wholly-bad file -> fall back to defaults
        compiled = [(v, re.compile(p), m, s) for v, p, m, s in _DEFAULT_RULES]
    return compiled


_RULES = _load_rules()


def decide(command):
    # A trailing `\` continues the command on the next line (the shell joins them), so join
    # backslash-continuations FIRST -- else a pipeline split across lines (`curl x |\` then
    # `sudo sh`) would be judged as two lines and slip past a single-line pipeline rule.
    command = command.replace('\\\n', '')
    # Judge EACH line and take the MOST RESTRICTIVE verdict (block > ask > allow): an
    # `allow` matching one line must not mask a `block`/`ask` matching another (searching
    # the whole multi-line string with first-match-wins would fail open). Per line the
    # FIRST matching rule wins, exactly the ordered-rule model for a single line.
    rank = {'allow': 0, 'ask': 1, 'block': 2}
    best = {'verdict': 'allow', 'message': '', 'suggestion': ''}
    for line in command.split('\n'):
        for verdict, pattern, message, suggestion in _RULES:
            if pattern.search(line):
                if rank[verdict] > rank[best['verdict']]:
                    best = {'verdict': verdict, 'message': message,
                            'suggestion': suggestion}
                break                # first matching rule wins for THIS line
    return best


def _has_line_continuation(command):
    """True if the batch cannot be judged line-by-line because a line runs ONTO the next --
    a trailing pipe / and-or list operator (`|`, `&&`, `||`, `&`), or an unbalanced quote or
    paren -- so the shell would run a command the per-line rules never saw whole (e.g.
    `curl x |` then `sh` executes `curl x | sh`). We do NOT reinvent a shell parser (never
    do); we conservatively refuse on any such signal. A trailing backslash is JOINED in
    decide(), so it is resolved here first, not a refusal."""
    joined = command.replace('\\\n', '')
    for line in joined.split('\n')[:-1]:
        # A trailing comment can hide a line-continuing operator: `curl x | # note` then
        # `sh` runs `curl x | sh`, yet the physical line ends with the comment. Test the
        # raw line AND a comment-stripped copy; refuse on either (fail closed). ORing the
        # two never REMOVES a refusal, so a `#` inside quotes (which mangles the strip) is
        # still caught by the raw test / the unbalanced-quote check below. No shell parser.
        bare = re.sub(r'\s#.*$', '', line)
        if line.rstrip().endswith(('|', '&')) or bare.rstrip().endswith(('|', '&')):
            return True
    if any(joined.count(q) % 2 for q in ('"', "'", '`')):
        return True
    return joined.count('(') != joined.count(')')


def main():
    try:
        request = json.load(sys.stdin)
    except (ValueError, OSError):
        # a malformed request -> allow (secure-terminal also fails open by
        # default); never crash, never block the user's terminal on a bug here.
        print(json.dumps({'verdict': 'allow'}))
        return 0
    # Version 2 sends the whole multi-line payload as `script`; judge it as a unit.
    # `command` mirrors `script` for version-1 handlers, so either key yields content.
    is_script = isinstance(request, dict) and request.get('script') is not None
    command = ((request.get('script') or request.get('command', ''))
               if isinstance(request, dict) else '')
    if is_script and _has_line_continuation(command):
        # A line runs onto the next, so the shell executes a command the per-line rules
        # never saw whole. Rather than reinvent a shell parser, FAIL CLOSED: ask, and do
        # NOT claim review (no multiline_reviewed) -- an unconfirmed batch is refused.
        print(json.dumps({'verdict': 'ask',
                          'message': 'multi-line batch has an unresolved line '
                                     'continuation; review it before it runs'}))
        return 0
    result = decide(command)
    # Confirm we reviewed the WHOLE multi-line script (each line judged), so secure-terminal
    # trusts an ALLOW; without this ack a batch fails closed. A fresh dict keeps the bool
    # from fighting decide()'s str-valued return type.
    out = {**result, 'multiline_reviewed': True} if is_script else result
    print(json.dumps(out))
    return 0


if __name__ == '__main__':
    sys.exit(main())
